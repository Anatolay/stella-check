language core;

// eff Check = check : Nat -> Nat

// work : [](<Check>(Nat -> Nat) -> Nat -> Nat)

fn work(f : [rel< | check : fn(Nat) -> Nat >] fn(Nat)->Nat, x : Nat) -> Nat {
  return handle { letm [rel< | > , rel< | check : fn(Nat) -> Nat >] g = f in g(x) } with {
      return n -> 0
    | (check : fn(Nat) -> Nat, n, r) -> 0
  }
}

fn identity(n : Nat) -> Nat {
  return n
}

fn main(x : Nat) -> Nat {
  return work(mod [rel< | check : fn(Nat) -> Nat >] { identity }, x)
}
